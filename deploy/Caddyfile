{
	email {$ACME_EMAIL}
	admin off
}

# Creator Portal and public API on one origin. Automatic HTTPS via Let's Encrypt / ZeroSSL,
# or Caddy's local CA when PIPELINE_DOMAIN is `localhost`.
{$PIPELINE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@api path /api/* /healthz /readyz
	handle @api {
		reverse_proxy api:8000
	}

	# The portal routes in the URL hash, so every page is index.html plus static files.
	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		file_server
	}
}

# Public S3 hostname so presigned Silo URLs resolve for reviewers.
# The Silo console (:9001) is deliberately not proxied.
s3.{$PIPELINE_DOMAIN} {
	encode zstd gzip
	reverse_proxy silo:9000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
