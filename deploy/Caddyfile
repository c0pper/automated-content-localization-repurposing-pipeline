{
	email {$ACME_EMAIL}
	admin off
}

# Public API. Automatic HTTPS via Let's Encrypt / ZeroSSL.
{$PIPELINE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy api:8000
}

# Public S3 hostname so presigned Silo URLs resolve for reviewers.
# The Silo console (:9001) is deliberately not proxied.
s3.{$PIPELINE_DOMAIN} {
	encode zstd gzip
	reverse_proxy silo:9000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
