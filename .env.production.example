# Copy to .env.production, fill every value, and keep it out of version control.
# Compose is invoked as: docker compose --env-file .env.production up -d

# --- Ingress -----------------------------------------------------------------
PIPELINE_DOMAIN=pipeline.example.com
ACME_EMAIL=ops@example.com

# --- Postgres ----------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Keep the password URL-encoded if it contains reserved characters.
PIPELINE_DATABASE_URL=postgresql+asyncpg://pipeline:replace-with-a-long-random-password@postgres:5432/pipeline

# --- Application secrets (32+ characters, unique) ----------------------------
PIPELINE_WORKSPACE_API_KEY=replace-with-32-plus-random-characters
PIPELINE_NOTIFICATION_SIGNING_SECRET=replace-with-32-plus-random-characters
PIPELINE_WEBHOOK_SECRET=replace-with-16-plus-random-characters

# --- Silo object storage -----------------------------------------------------
PIPELINE_SILO_ACCESS_KEY=replace-with-access-key
PIPELINE_SILO_SECRET_KEY=replace-with-long-random-secret
PIPELINE_SILO_BUCKET=pipeline
PIPELINE_SILO_REGION=us-east-1

# --- Optional ----------------------------------------------------------------
# PIPELINE_IMAGE=automated-content-pipeline:1.0.0
# PIPELINE_NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/pipeline
# PIPELINE_LIP_SYNC_ENABLED=false
# PIPELINE_CORS_ALLOWED_ORIGINS=https://app.example.com
# PIPELINE_JOB_BUDGET_USD=50.00
# PIPELINE_MONTHLY_BUDGET_USD=500.00
# PIPELINE_MAX_CONCURRENT_JOBS=2
# PIPELINE_RETENTION_DAYS=7
# PIPELINE_BACKUP_RETENTION_DAYS=30
# BACKUP_HOUR=2
# BACKUP_ON_START=false
