# Run the production Compose stack on your own machine, without a domain.
# Copy to .env.production, replace every secret, then:
#   docker compose --env-file .env.production up -d --build
# Caddy serves https://localhost and https://s3.localhost from its own local CA;
# trust its root certificate once (docs/deployment.md, "Local trial without a domain").
# This is for trying the stack out, not for real users: there is no off-host backup.

# --- Ingress -----------------------------------------------------------------
PIPELINE_DOMAIN=localhost

# --- Postgres ----------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-a-long-random-password
PIPELINE_DATABASE_URL=postgresql+asyncpg://pipeline:replace-with-a-long-random-password@postgres:5432/pipeline

# --- Application secrets (32+ characters, unique) ----------------------------
PIPELINE_WORKSPACE_API_KEY=replace-with-32-plus-random-characters
PIPELINE_NOTIFICATION_SIGNING_SECRET=replace-with-32-plus-random-characters
PIPELINE_WEBHOOK_SECRET=replace-with-16-plus-random-characters

# --- Silo object storage -----------------------------------------------------
PIPELINE_SILO_ACCESS_KEY=replace-with-access-key
PIPELINE_SILO_SECRET_KEY=replace-with-long-random-secret

# --- Optional: real AI providers (stubs are used when unset) -----------------
# PIPELINE_OPENAI_API_KEY=
# PIPELINE_OPENROUTER_API_KEY=
# PIPELINE_ELEVENLABS_API_KEY=
