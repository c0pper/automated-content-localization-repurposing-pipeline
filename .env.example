# Copy to .env and adjust for local development.

PIPELINE_ENVIRONMENT=local
PIPELINE_DATA_DIR=.data
PIPELINE_PUBLIC_BASE_URL=http://localhost:8000/assets
PIPELINE_API_BASE_URL=http://localhost:8000
PIPELINE_WORKSPACE_API_KEY=dev-workspace-key

# Persistence, queue and object storage.
# memory | sqlite | postgres
PIPELINE_REPOSITORY_BACKEND=memory
# PIPELINE_DATABASE_URL=sqlite+aiosqlite:///./.data/pipeline.db
# PIPELINE_DATABASE_URL=postgresql+asyncpg://pipeline:secret@localhost:5432/pipeline
# memory | redis
PIPELINE_QUEUE_BACKEND=memory
PIPELINE_REDIS_URL=redis://localhost:6379/0
# local | silo
PIPELINE_OBJECT_STORE_BACKEND=local
# PIPELINE_SILO_ENDPOINT=http://localhost:9000
# PIPELINE_SILO_PUBLIC_ENDPOINT=http://localhost:9000
# PIPELINE_SILO_BUCKET=pipeline
# PIPELINE_SILO_REGION=us-east-1
# PIPELINE_SILO_ACCESS_KEY=
# PIPELINE_SILO_SECRET_KEY=
PIPELINE_PRESIGN_TTL_SECONDS=900

# Run the in-process queue worker alongside the API.
PIPELINE_RUN_WORKER=true
PIPELINE_WORKER_POLL_SECONDS=0.25
PIPELINE_WORKER_CAPACITY=4

# "stub" runs end-to-end without ffmpeg or paid APIs. "ffmpeg" uses local binaries.
PIPELINE_MEDIA_BACKEND=stub
PIPELINE_LIP_SYNC_ENABLED=false

# Provider credentials. Stub adapters are used when unset.
PIPELINE_OPENAI_API_KEY=
PIPELINE_OPENROUTER_API_KEY=
PIPELINE_ELEVENLABS_API_KEY=
PIPELINE_SYNCLABS_API_KEY=
PIPELINE_PROVIDER_TIMEOUT_SECONDS=120
PIPELINE_PROVIDER_MAX_ATTEMPTS=3

# Guardrails
PIPELINE_ALLOWED_INPUT_SUFFIXES=.mp4,.mov,.m4v
PIPELINE_TARGET_LANGUAGE_ALLOWLIST=en,es,de,pt-BR,fr,it
PIPELINE_SUPPORTED_SOURCE_LANGUAGES=en,es,de,pt-BR,fr,it,ja,ko,zh
PIPELINE_MAX_VIDEO_MINUTES=90
PIPELINE_MAX_CHARACTERS_PER_JOB=60000
PIPELINE_MAX_SOURCE_BYTES=2000000000
PIPELINE_MAX_TARGET_LANGUAGES=3
PIPELINE_MIN_CLIPS_PER_JOB=3
PIPELINE_MAX_CLIPS_PER_JOB=5
PIPELINE_QUALITY_FLOOR=70
PIPELINE_JOB_BUDGET_USD=50.00
PIPELINE_MONTHLY_BUDGET_USD=500.00
PIPELINE_MAX_CONCURRENT_JOBS=2
PIPELINE_COST_MARGIN=0.20
PIPELINE_RATE_CARD_VERSION=2026-10-01
# PIPELINE_RATE_CARD_PATH=./rate-card.json

# Data retention
PIPELINE_RETENTION_DAYS=7
PIPELINE_RETENTION_SWEEP_SECONDS=86400
PIPELINE_EXPIRY_SWEEP_SECONDS=60
PIPELINE_NOTIFICATION_SWEEP_SECONDS=30
PIPELINE_SELECTION_GATE_DAYS=7
PIPELINE_IDEMPOTENCY_RETENTION_DAYS=7
PIPELINE_BACKUP_RETENTION_DAYS=30
PIPELINE_PURGE_CONFIRMATION_TTL_SECONDS=600

# Optional webhook authentication and delivery notification
PIPELINE_WEBHOOK_SECRET=
PIPELINE_NOTIFICATION_WEBHOOK_URL=
PIPELINE_NOTIFICATION_SIGNING_SECRET=dev-notification-secret
PIPELINE_CORS_ALLOWED_ORIGINS=http://localhost:3000
